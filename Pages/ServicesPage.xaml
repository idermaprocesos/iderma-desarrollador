<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Consola.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Consola.Models">

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Servicios de Windows" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton Icon="Refresh" Label="Actualizar" Click="Refresh_Click" />
                <AppBarButton Icon="Play" Label="Iniciar" Click="Start_Click" />
                <AppBarButton Icon="Stop" Label="Detener" Click="Stop_Click" />
                <AppBarButton Label="Reiniciar" Click="Restart_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <AutoSuggestBox x:Name="SearchBox" Width="320" HorizontalAlignment="Left" QueryIcon="Find"
                            PlaceholderText="Filtrar servicios" TextChanged="Search_TextChanged" />
            <InfoBar x:Name="EmptyBar" IsOpen="False" IsClosable="False" Severity="Informational" />
        </StackPanel>
        <ListView x:Name="ServiceList" Grid.Row="2" SelectionMode="Single">
            <ListView.Header>
                <Grid Padding="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Nombre" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Estado" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Inicio" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="PID" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Cuenta" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Ruta" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ServiceRow">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Name}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind StartType}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Pid}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Account}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
