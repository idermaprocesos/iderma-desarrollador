<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Consola.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Consola.Models">

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Actividad del sistema" />
            <TextBlock x:Name="TargetText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Trazas ETW de archivo, registro, red, módulos, procesos, excepciones y syscalls. Requiere administrador para el proveedor del kernel." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ToggleSwitch x:Name="CaptureSwitch" OffContent="Captura detenida" OnContent="Captura en vivo" Toggled="Capture_Toggled" />
            <CheckBox x:Name="FileCheck" Content="Archivo" IsChecked="True" />
            <CheckBox x:Name="RegCheck" Content="Registro" IsChecked="True" />
            <CheckBox x:Name="NetCheck" Content="Red" IsChecked="True" />
            <CheckBox x:Name="ImgCheck" Content="Módulos" IsChecked="True" />
            <CheckBox x:Name="ProcCheck" Content="Procesos" IsChecked="True" />
            <CheckBox x:Name="ExCheck" Content="Excepciones" IsChecked="True" />
            <CheckBox x:Name="SysCheck" Content="Syscalls" />
            <CheckBox x:Name="FilterCheck" Content="Solo proceso seleccionado" IsChecked="True" Click="Filter_Changed" />
        </StackPanel>

        <InfoBar x:Name="EtwBar" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <ListView x:Name="EventList" Grid.Row="3">
            <ListView.Header>
                <Grid Padding="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Hora" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Tipo" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="PID" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Proceso" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Operación" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Detalle" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SyscallEvent">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TimeText}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Kind}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Pid}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Process}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Operation}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
