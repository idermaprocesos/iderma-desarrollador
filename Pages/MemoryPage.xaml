<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Consola.Pages.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Consola.Models">

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Memoria y fugas" />
            <TextBlock x:Name="TargetText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Dictamen" />
                    <TextBlock x:Name="VerdictTitle" Style="{StaticResource MetricValueStyle}" FontSize="22" TextWrapping="Wrap" />
                    <TextBlock x:Name="VerdictDetail" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Privada" />
                    <TextBlock x:Name="PrivateValue" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Handles" />
                    <TextBlock x:Name="HandleValue" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="GDI / USER" />
                    <TextBlock x:Name="GdiValue" Style="{StaticResource MetricValueStyle}" FontSize="22" />
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="SparkCanvas" Grid.Row="2" Height="90" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="SampleList">
                <ListView.Header>
                    <TextBlock Margin="12,8" FontWeight="SemiBold" Text="Muestras (privada, working set, handles, hilos)" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MemorySample">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TimeText}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PrivateText}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind WorkingSetText}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Handles}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Threads}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="GlobalLeaks" Grid.Column="1">
                <ListView.Header>
                    <TextBlock Margin="12,8" FontWeight="SemiBold" Text="Procesos con crecimiento anómalo" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardAlert">
                        <StackPanel Margin="0,6">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
