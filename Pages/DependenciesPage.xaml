<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Consola.Pages.DependenciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Consola.Models">

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Dependencias y red" />
                <TextBlock x:Name="PathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Al elegir un programa se listan imports PE, delay-load, .NET, archivos de su carpeta y conexiones TCP/UDP." />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton Icon="Refresh" Label="Actualizar" Click="Refresh_Click" />
                <AppBarButton Icon="Folder" Label="Abrir carpeta" Click="OpenFolder_Click" />
            </CommandBar>
        </Grid>

        <InfoBar x:Name="EmptyBar" Grid.Row="1" Title="Ningún proceso seleccionado"
                 Message="Elige un programa en Programas activos. Aquí verás qué DLLs usa o puede usar, los archivos de su carpeta y si sale a Internet."
                 IsOpen="True" Severity="Informational" />

        <Grid x:Name="MetricsGrid" Grid.Row="2" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Dependencias" />
                    <TextBlock x:Name="DepsValue" Style="{StaticResource MetricValueStyle}" FontSize="22" />
                    <TextBlock x:Name="DepsDetail" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Carpeta del programa" />
                    <TextBlock x:Name="FolderValue" Style="{StaticResource MetricValueStyle}" FontSize="22" />
                    <TextBlock x:Name="FolderDetail" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Internet" />
                    <TextBlock x:Name="NetValue" Style="{StaticResource MetricValueStyle}" FontSize="22" />
                    <TextBlock x:Name="NetDetail" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Sockets" />
                    <TextBlock x:Name="SockValue" Style="{StaticResource MetricValueStyle}" FontSize="22" />
                    <TextBlock x:Name="SockDetail" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Pivot x:Name="DetailPivot" Grid.Row="3" Visibility="Collapsed">
            <PivotItem Header="Dependencias">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="DepSearch" Width="360" HorizontalAlignment="Left" QueryIcon="Find"
                                    PlaceholderText="Filtrar DLL, estado o tipo"
                                    TextChanged="Filter_TextChanged" />
                    <ListView x:Name="DepList" Grid.Row="1">
                        <ListView.Header>
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Módulo" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Tipo" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Estado" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Ruta" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DependencyRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Company}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Carpeta madre">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="FileSearch" Width="360" HorizontalAlignment="Left" QueryIcon="Find"
                                    PlaceholderText="Filtrar archivos de la carpeta"
                                    TextChanged="Filter_TextChanged" />
                    <ListView x:Name="FileList" Grid.Row="1">
                        <ListView.Header>
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Nombre" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Tipo" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Rol" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Tamaño" />
                                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Uso" />
                                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Modificado" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FolderFileRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Role}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind LoadedText}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ModifiedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Internet y sockets">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="NetSearch" Width="360" HorizontalAlignment="Left" QueryIcon="Find"
                                    PlaceholderText="Filtrar IP, puerto o HTTPS"
                                    TextChanged="Filter_TextChanged" />
                    <ListView x:Name="NetList" Grid.Row="1">
                        <ListView.Header>
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Proto" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Ámbito" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Local" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Remoto" />
                                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Estado" />
                                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Servicio" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NetConnectionRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Protocol}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Scope}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Local}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Remote}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind State}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Hint}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
